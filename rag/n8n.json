{
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rag-master",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [0, 400]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.body.action }}",
        "rules": {
          "rules": [
            {
              "value2": "ingest"
            },
            {
              "value2": "ask",
              "output": 1
            },
            {
              "value2": "delete_file",
              "output": 2
            },
            {
              "value2": "delete_collection",
              "output": 3
            }
          ]
        },
        "fallbackOutput": 4
      },
      "id": "2",
      "name": "Action Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [220, 400]
    },
    {
      "parameters": {
        "url": "={{ $json.body.url }}",
        "responseFormat": "file",
        "options": {}
      },
      "id": "3",
      "name": "Download File",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [500, 100]
    },
    {
      "parameters": {
        "mode": "insert",
        "qdrantCollection": "={{ $('Webhook').item.json.body.collection_name }}",
        "options": {}
      },
      "id": "4",
      "name": "Qdrant Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1,
      "position": [700, 100]
    },
    {
      "parameters": {},
      "id": "5",
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1,
      "position": [820, 300]
    },
    {
      "parameters": {},
      "id": "6",
      "name": "Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "7",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1,
      "position": [500, 400]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {}
      },
      "id": "8",
      "name": "Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [500, 600]
    },
    {
      "parameters": {
        "name": "vector_database",
        "description": "Call this tool to search the vector database for context.",
        "qdrantCollection": "={{ $('Webhook').item.json.body.collection_name }}"
      },
      "id": "9",
      "name": "Qdrant Vector Store Tool",
      "type": "@n8n/n8n-nodes-langchain.toolVectorStoreQdrant",
      "typeVersion": 1,
      "position": [660, 600]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://YOUR_LINUX_IP:6333/collections/{{ $json.body.collection_name }}/points/delete",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "filter",
              "value": "={{ JSON.stringify({ must: [{ key: \"metadata.source\", match: { value: $json.body.url } }] }) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "10",
      "name": "Delete File API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [500, 780]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "=http://YOUR_LINUX_IP:6333/collections/{{ $json.body.collection_name }}",
        "options": {}
      },
      "id": "11",
      "name": "Drop Collection API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [500, 960]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"status\": \"success\",\n  \"message\": \"Document ingested and vectorized successfully.\"\n}",
        "options": {}
      },
      "id": "12",
      "name": "Respond Ingest",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1080, 100]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "13",
      "name": "Respond AI",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1080, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"status\": \"success\",\n  \"message\": \"All vector points associated with that URL have been deleted.\"\n}",
        "options": {}
      },
      "id": "14",
      "name": "Respond File Delete",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [720, 780]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"status\": \"success\",\n  \"message\": \"Entire collection has been wiped.\"\n}",
        "options": {}
      },
      "id": "15",
      "name": "Respond Coll Delete",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [720, 960]
    }
  ],
